# Copy to `.env` and fill in. The .env file is git-ignored.
# main.py auto-loads these on startup (shell env vars take precedence).

# Required for multi-speaker diarization (pyannote.audio).
# Accept license terms on the three pyannote model pages, then create a
# Read-access token at https://huggingface.co/settings/tokens.
HF_TOKEN=

# Required only if cfg.llm.provider=="litellm" AND model targets Anthropic
# (e.g. model: "anthropic/claude-sonnet-4-5"). For other vendors set the
# corresponding key (OPENAI_API_KEY, GROQ_API_KEY, GEMINI_API_KEY, ...).
# When cfg.llm.provider=="claude_cli", no API key is needed — the Claude
# CLI must be on PATH and logged in.
ANTHROPIC_API_KEY=
