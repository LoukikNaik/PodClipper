# Copy to `.env` and fill in. The .env file is git-ignored.
# main.py auto-loads these on startup (shell env vars take precedence).

# Required for multi-speaker diarization (pyannote.audio).
# Accept license terms on the three pyannote model pages, then create a
# Read-access token at https://huggingface.co/settings/tokens.
HF_TOKEN=

# Required only if cfg.llm.provider=="anthropic_api".
# Otherwise the Claude CLI is used (must be on PATH and logged in).
ANTHROPIC_API_KEY=
