# Copy to `.env` and fill in. The .env file is git-ignored.
# main.py auto-loads these on startup (shell env vars take precedence).

# Required for multi-speaker diarization (pyannote.audio).
# Accept license terms on the three pyannote model pages, then create a
# Read-access token at https://huggingface.co/settings/tokens.
HF_TOKEN=

# LLM API keys (only needed when cfg.llm.provider=="litellm").
# Which one is read depends on cfg.llm.model and cfg.llm.litellm.api_key_env:
#   - cfg.llm.litellm.api_key_env unset → litellm picks by model prefix
#       anthropic/...  →  ANTHROPIC_API_KEY
#       openai/...     →  OPENAI_API_KEY
#       groq/...       →  GROQ_API_KEY
#       gemini/...     →  GEMINI_API_KEY
#   - cfg.llm.litellm.api_key_env="TOKENROUTER_API_KEY" → reads TOKENROUTER_API_KEY
#     (use this when pointing api_base at a gateway like TokenRouter / OpenRouter).
# When cfg.llm.provider=="claude_cli", no key is needed — Claude CLI must be
# on PATH and logged in.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# TOKENROUTER_API_KEY=
